<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto mt-10 max-w-6xl px-4">
      <div class="flex items-center justify-between mb-6">
        <div><div class="section-kicker">Your journeys</div><h1 class="section-heading">My bookings</h1></div>
        <div class="flex gap-2">
          <a href="#upcoming" class="bg-red-500 text-white px-4 py-2 rounded-md hover:bg-red-600 transition duration-300">Upcoming</a>
          <a href="#past" class="bg-gray-200 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-300 transition duration-300">Past</a>
          <a href="#cancelled" class="bg-gray-200 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-300 transition duration-300">Cancelled</a>
        </div>
      </div>

      <% if (message) { %>
        <div class="mb-5 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-green-700"><%= message %></div>
      <% } %>
      <% if (error) { %>
        <div class="mb-5 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-red-700"><%= error %></div>
      <% } %>

      <section id="upcoming" class="mb-10">
        <h2 class="text-2xl font-semibold text-gray-800 mb-4">Upcoming</h2>
        <% if (upcoming.length === 0) { %>
          <p class="text-gray-500">No upcoming bookings.</p>
        <% } else { %>
          <div class="space-y-5">
            <% upcoming.forEach(booking => { %>
              <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                  <div>
                    <h3 class="text-2xl font-semibold text-gray-800"><%= booking.home ? booking.home.houseName : 'Property unavailable' %></h3>
                    <p class="text-gray-600"><%= booking.home ? booking.home.location : 'The original listing is no longer available.' %></p>
                  </div>
                  <div class="text-sm text-gray-500">
                    <span class="font-medium text-gray-700">Status:</span>
                    <span class="text-green-600 font-semibold"><%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %></span>
                  </div>
                </div>

                <div class="mt-4 grid gap-2 md:grid-cols-4 text-sm text-gray-700">
                  <div><span class="font-medium">Check-in:</span> <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></div>
                  <div><span class="font-medium">Check-out:</span> <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></div>
                  <div><span class="font-medium">Guests:</span> <%= booking.guests %></div>
                  <div><span class="font-medium">Total:</span> <%= formatCurrency(booking.totalPrice) %></div>
                </div>

                <div class="mt-4 flex flex-wrap gap-3">
                  <a href="/bookings/<%= booking._id %>" class="bg-red-500 text-white px-4 py-2 rounded-md hover:bg-red-600 transition duration-300">View Details</a>
                  <% if (booking.home) { %><a href="/homes/<%= booking.home._id %>" class="bg-gray-200 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-300 transition duration-300">View Property</a><% } %>
                  <form action="/bookings/<%= booking._id %>/cancel" method="POST" onsubmit="return confirm('Cancel this booking?')">
                    <button type="submit" class="bg-gray-800 text-white px-4 py-2 rounded-md hover:bg-gray-900 transition duration-300">Cancel Booking</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section id="past" class="mb-10">
        <h2 class="text-2xl font-semibold text-gray-800 mb-4">Past</h2>
        <% if (past.length === 0) { %>
          <p class="text-gray-500">No past bookings.</p>
        <% } else { %>
          <div class="space-y-5">
            <% past.forEach(booking => { %>
              <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
                <h3 class="text-xl font-semibold text-gray-800"><%= booking.home ? booking.home.houseName : 'Property unavailable' %></h3>
                <p class="text-gray-600"><%= booking.home ? booking.home.location : 'The original listing is no longer available.' %></p>
                <div class="mt-3 grid gap-2 md:grid-cols-4 text-sm text-gray-700">
                  <div><span class="font-medium">Check-in:</span> <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></div>
                  <div><span class="font-medium">Check-out:</span> <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></div>
                  <div><span class="font-medium">Guests:</span> <%= booking.guests %></div>
                  <div><span class="font-medium">Total:</span> <%= formatCurrency(booking.totalPrice) %></div>
                </div>
                <div class="mt-4">
                  <a href="/bookings/<%= booking._id %>" class="bg-red-500 text-white px-4 py-2 rounded-md hover:bg-red-600 transition duration-300">View Details</a>
                  <% const reviewState = reviewStatusByBooking[booking._id.toString()]; %>
                  <% if (booking.home && reviewState && reviewState.reviewId) { %>
                    <a href="/reviews/<%= reviewState.reviewId %>" class="booking-review-link">View review</a>
                    <a href="/reviews/<%= reviewState.reviewId %>/edit" class="booking-review-link">Edit review</a>
                  <% } else if (booking.home && reviewState && reviewState.eligible) { %>
                    <a href="/bookings/<%= booking._id %>/review" class="booking-review-link">Write a review</a>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section id="cancelled">
        <h2 class="text-2xl font-semibold text-gray-800 mb-4">Cancelled</h2>
        <% if (cancelled.length === 0) { %>
          <p class="text-gray-500">No cancelled bookings.</p>
        <% } else { %>
          <div class="space-y-5">
            <% cancelled.forEach(booking => { %>
              <div class="rounded-xl border border-red-200 bg-red-50 p-5 shadow-sm">
                <h3 class="text-xl font-semibold text-gray-800"><%= booking.home ? booking.home.houseName : 'Property unavailable' %></h3>
                <p class="text-gray-600"><%= booking.home ? booking.home.location : 'The original listing is no longer available.' %></p>
                <div class="mt-3 grid gap-2 md:grid-cols-4 text-sm text-gray-700">
                  <div><span class="font-medium">Check-in:</span> <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></div>
                  <div><span class="font-medium">Check-out:</span> <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></div>
                  <div><span class="font-medium">Guests:</span> <%= booking.guests %></div>
                  <div><span class="font-medium">Total:</span> <%= formatCurrency(booking.totalPrice) %></div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
