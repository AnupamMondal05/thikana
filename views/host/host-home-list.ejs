<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="container mx-auto p-8 mt-10 max-w-6xl">
      <div class="mb-10"><div class="section-kicker">Your dashboard</div><h2 class="section-heading">Your homes</h2><p class="text-gray-600">Manage your spaces and keep your listings looking their best.</p></div>
      <% if (!registeredHomes.length) { %><div class="empty-state"><h3>You haven't listed a stay yet.</h3><p class="property-meta">Share your space with travellers looking for their next escape.</p><a href="/host/add-home" class="button-primary">Add your first property</a></div><% } %>
      <div class="home-grid">
        <% registeredHomes.forEach(home => { %>
          <div class="property-card">
            <img src="<%= (home.photos && home.photos.length ? home.photos[0] : home.photo) %>"
            alt="<%= home.houseName %>" class="property-image" loading="lazy">
            <div class="property-card-body">
              <h3><%= home.houseName %></h3>
              <p class="property-meta mb-3">⌖ <%= home.location %></p>
              <div class="flex justify-between items-center mb-2">
                <span class="property-price">₹<%= home.price %> <span class="property-meta font-normal">/ night</span></span>
                <% if (home.rating) { %><span class="rating">★ <%= home.rating %></span><% } %>
              </div>
              <div class="flex flex-wrap gap-3">
                <a href="/host/edit-home/<%=home._id%>?editing=true" class="button-primary" style="padding:9px 14px;font-size:.85rem">Edit</a>
                <form action="/host/delete-home/<%=home._id%>" method="POST" onsubmit="return confirm('Delete this property listing?')">
                  <button type="submit" class="button-secondary">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
